 roe"},{"start1":6687,"start2":7495,"text":"\nBut when"},{"start1":6697,"start2":7504,"text":" "},{"start1":6703,"start2":7506,"text":"en"},{"start1":6710,"start2":7508,"text":"e"},{"start1":6715,"start2":7510,"text":"th "},{"start1":6720,"start2":7515,"text":"n"},{"start1":6723,"start2":7521,"text":"t"},{"start1":6724,"start2":7525,"text":"ies,\n"},{"start1":6732,"start2":7532,"text":"e "},{"start1":6737,"start2":7534,"text":"a"},{"start1":6740,"start2":7541,"text":"r"},{"start1":6741,"start2":7544,"text":"e "},{"start1":6747,"start2":7547,"text":"e"},{"start1":6748,"start2":7551,"text":"l"},{"start1":6753,"start2":7553,"text":" appears\nBut Death"},{"start1":6771,"start2":7573,"text":" born bride"},{"start1":6783,"start2":7584,"text":"—the stoniest eyes\nMight break in tears"},{"start1":6823,"start2":7624,"text":"\n"},{"start1":6831,"start2":7625,"text":"Unspeakable! unspeakable! Ah me,\nA horrible oppression of despair,\nVague, vast, and ston"},{"start1":6920,"start2":7713,"text":"y, like a shapeless crag\nFalling on my young life in its wild track\nOver the mountain miseries of the world,\nDoth into a dread union with itself\nCrush all my being—body and mind together!\n"}]}
